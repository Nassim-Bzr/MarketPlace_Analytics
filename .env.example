# Copier ce fichier en .env :  cp .env.example .env
# Identifiants de FORMATION uniquement.

# Services à profil : "api" = API Marketplace, "bi" = Metabase (retirer "bi" pour économiser ~1 Go de RAM)
COMPOSE_PROFILES=api,bi

# --- Airflow ---
# Sortie de `id -u` (Linux) — évite les fichiers de logs appartenant à root
AIRFLOW_UID=1000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
# Générer avec : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=change-me
AIRFLOW_API_SECRET_KEY=change-me

# --- Postgres métadonnées Airflow ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# --- Postgres Data Warehouse ---
DWH_USER=dwh_user
DWH_PASSWORD=dwh_password_2026
DWH_DB=dwh

# --- MinIO ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password_2026

# --- API Marketplace ---
MARKETPLACE_API_TOKEN=formation-token-2026
ORDERS_PER_DAY=1000
